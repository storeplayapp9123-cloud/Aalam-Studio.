<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Project"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"/>

        <!-- 1. Choose Project Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Choose Project Type"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/typeGame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_card"
                android:padding="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_type_game"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Game"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/typeApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_card"
                android:padding="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_type_app"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/type3D"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_card"
                android:padding="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_type_3d"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D Experience"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/typeTemplate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_card"
                android:padding="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_type_template"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Template"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <!-- 2-column: Details (left) + Type options (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- LEFT: Project Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Project Details"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Project Name"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/inputProjectName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="My Project"
                    android:textColorHint="#555555"
                    android:textColor="#FFFFFF"
                    android:background="#1A1A1A"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Package Name"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/inputPackageName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="com.example.myproject"
                    android:textColorHint="#555555"
                    android:textColor="#FFFFFF"
                    android:background="#1A1A1A"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Project Location"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/locationPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="/AalamStudio/Projects/"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:background="#1A1A1A"
                    android:padding="10dp"
                    android:layout_marginBottom="14dp"/>

                <!-- Target Platform -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Platform"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:id="@+id/platformAndroid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_type_card"
                        android:padding="6dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤖" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Android" android:textColor="#FFFFFF" android:textSize="9sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/platformWindows"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_type_card"
                        android:padding="6dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪟" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Windows" android:textColor="#FFFFFF" android:textSize="9sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/platformMac"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_type_card"
                        android:padding="6dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🍎" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="macOS" android:textColor="#FFFFFF" android:textSize="9sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/platformLinux"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_type_card"
                        android:padding="6dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐧" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Linux" android:textColor="#FFFFFF" android:textSize="9sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/platformIos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_type_card"
                        android:padding="6dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="iOS" android:textColor="#FFFFFF" android:textSize="9sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/platformCustom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_type_card"
                        android:padding="6dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⋯" android:textSize="16sp" android:textColor="@color/gold" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom" android:textColor="#FFFFFF" android:textSize="9sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Custom platform multi-select -->
                <LinearLayout
                    android:id="@+id/customPlatformContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="10dp"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select platforms to target:"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:id="@+id/customPlatformCheckboxContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>

                <!-- App Language (dynamic, single-platform) -->
                <LinearLayout
                    android:id="@+id/appLanguageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Language"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:id="@+id/appLanguageGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>

                <!-- App Language (multi-platform custom) -->
                <LinearLayout
                    android:id="@+id/appLanguageCustomContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select languages to combine:"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:id="@+id/appLanguageCustomCheckboxContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>

            </LinearLayout>

            <!-- RIGHT: Type-specific options -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Configuration"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- App-only options -->
                <LinearLayout
                    android:id="@+id/panelAppOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orientation"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/orientPortrait"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_type_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Portrait"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/orientLandscape"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:background="@drawable/bg_type_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Landscape"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- Game-only options -->
                <LinearLayout
                    android:id="@+id/panelGameOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Game Type"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:id="@+id/game2D"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_type_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2D"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/game3D"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:background="@drawable/bg_type_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3D"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"/>
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/gameOrientationContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Orientation"
                            android:textColor="#AAAAAA"
                            android:textSize="11sp"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/gameOrientPortrait"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:gravity="center"
                                android:background="@drawable/bg_type_card">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Portrait"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/gameOrientLandscape"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:background="@drawable/bg_type_card">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Landscape"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/gameOrientationLockedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orientation: Landscape (fixed for 3D)"
                        android:textColor="#777777"
                        android:textSize="11sp"
                        android:visibility="gone"/>

                    <!-- Game Language (dynamic, single-platform) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Game Language"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:id="@+id/gameLanguageGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <!-- Custom language multi-select (single platform "Custom" language card) -->
                    <LinearLayout
                        android:id="@+id/customLanguageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="10dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select languages to combine:"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:id="@+id/customLanguageCheckboxContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>

                    </LinearLayout>

                    <!-- Game Language (multi-platform custom) -->
                    <LinearLayout
                        android:id="@+id/gameLanguageCustomPlatformContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="10dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select languages to combine:"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:id="@+id/gameLanguageCustomPlatformCheckboxContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Preview card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Project Preview"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/previewName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Project"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/previewDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="App • Portrait"
                        android:textColor="@color/gold"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnCreateProject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Create Project"
                android:backgroundTint="@color/gold"
                android:textColor="#000000"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
